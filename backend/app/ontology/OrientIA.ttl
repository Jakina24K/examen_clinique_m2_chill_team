###  http://www.semanticweb.org/oracle/ontologies/2026/7/untitled-ontology-14/necessite
:necessite rdf:type owl:ObjectProperty ;
           rdfs:domain :parcours ;
           rdfs:range :prerequis .


###  http://www.semanticweb.org/oracle/ontologies/2026/7/untitled-ontology-14/possede
:possede rdf:type owl:ObjectProperty ;
         rdfs:domain :etudiant ;
         rdfs:range :competences .


###  http://www.semanticweb.org/oracle/ontologies/2026/7/untitled-ontology-14/prefere
:prefere rdf:type owl:ObjectProperty ;
         rdfs:domain :etudiant ;
         rdfs:range :matieres .


###  http://www.semanticweb.org/oracle/ontologies/2026/7/untitled-ontology-14/prepareA
